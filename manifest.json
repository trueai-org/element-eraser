{
  "manifest_version": 3,
  "name": "网页元素删除器",
  "version": "2.0.0",
  "description": "点击删除网页上的任何元素，支持CSS选择器和XPath",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "元素删除器",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils.js", "content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}